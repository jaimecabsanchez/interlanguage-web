/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# La plataforma revalida siempre, para que los cambios de código lleguen a las familias
/plataforma/*.js
  Cache-Control: no-cache

/plataforma/*.css
  Cache-Control: no-cache
