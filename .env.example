# ============================================================
#  VARIABLES DE ENTORNO · Interlanguage (plantilla de ejemplo)
# ------------------------------------------------------------
#  Copia este archivo como  .env  y rellena los valores reales.
#  El archivo .env NO se sube a git (está en .gitignore).
#
#  IMPORTANTE (seguridad):
#   • La ANON KEY es PÚBLICA (va en el navegador, protegida por RLS). OK que se vea.
#   • La SERVICE_ROLE es SECRETA: NUNCA en el navegador ni en el repo.
#     Vive SOLO como secreto de las Edge Functions de Supabase.
#   • Las claves de correo (Resend) son SECRETAS.
#  Detalle: docs/superpowers/specs/2026-07-29-arquitectura-tecnica-mvp.md (§secretos)
# ============================================================

# --- Supabase (proyecto de DESARROLLO; usa otros valores en staging/producción) ---
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY="TU-ANON-KEY-PUBLICA"

# --- SOLO servidor (Edge Functions). NUNCA en el cliente. ---
SUPABASE_SERVICE_ROLE_KEY="TU-SERVICE-ROLE-SECRETA"

# --- Correo (informes a familias / reset). Se configura en el Bloque 14. ---
RESEND_API_KEY="TU-RESEND-API-KEY"
MAIL_FROM="Interlanguage <no-reply@tudominio>"

# --- Entorno actual: local | staging | production ---
APP_ENV="local"
