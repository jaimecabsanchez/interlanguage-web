# ============================================================
#  VARIABLES DE ENTORNO · STAGING (ejemplo)
# ------------------------------------------------------------
#  Staging usa un proyecto Supabase SEPARADO del de desarrollo y del de
#  producción (datos de prueba, nunca datos reales de menores).
#  Copia como .env.staging y rellena con los valores del proyecto de staging.
#  Reglas de secretos idénticas a .env.example (la sb_secret_ NUNCA en el cliente).
# ============================================================

SUPABASE_URL="https://TU-PROYECTO-STAGING.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_STAGING"

# Solo servidor (Edge Functions). NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_STAGING"

# Correo de pruebas
RESEND_API_KEY="TU-RESEND-API-KEY-STAGING"
MAIL_FROM="Interlanguage (staging) <no-reply@tudominio>"

APP_ENV="staging"
